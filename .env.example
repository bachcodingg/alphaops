# Copy to .env and fill in. .env is git-ignored: never commit real tokens.

# Storage and metrics
ALPHAOPS_DB=data/alphaops.db
ALPHAOPS_METRICS_DIR=data/metrics
# ALPHAOPS_PUSHGATEWAY_URL=http://localhost:9091

# Alert channels (optional; without them alerts only go to the log)
# ALPHAOPS_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# ALPHAOPS_TELEGRAM_BOT_TOKEN=123456:ABC...
# ALPHAOPS_TELEGRAM_CHAT_ID=123456789

# Thresholds
ALPHAOPS_MAX_SYMBOL_FAILURE_RATE=0.2   # above this share of failed symbols the run is FAILED
ALPHAOPS_STALE_AFTER_HOURS=26          # health: max age of the last successful ingest
ALPHAOPS_MAX_ABS_RETURN=0.35           # data quality: daily move treated as bad data

# Daily script (scripts/run_daily.sh)
ALPHAOPS_SOURCE=yahoo
ALPHAOPS_UNIVERSE=config/universe_hose.csv
ALPHAOPS_ALPHAS=examples/alphas.toml
